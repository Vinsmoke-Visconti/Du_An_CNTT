        <!-- Security response note -->
        <mxCell id="response" value="&lt;b&gt;Continuous monitoring&lt;/b&gt;&lt;br&gt;Wazuh detects notable events and raises alerts.&lt;br&gt;&lt;font color=&#x27;#991b1b&#x27;&gt;Current PoC docs do not define automatic session revocation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#f59e0b;fillColor=#fff7ed;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="205" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2563eb&#x27;&gt;━━━&lt;/font&gt; Data / access flow    &lt;font color=&#x27;#7c3aed&#x27;&gt;- - -&lt;/font&gt; Control / security flow&lt;br&gt;&lt;font color=&#x27;#0f766e&#x27;&gt;PEP&lt;/font&gt; = Policy Enforcement Point   &lt;font color=&#x27;#7c3aed&#x27;&gt;IdP&lt;/font&gt; = Identity Provider   &lt;font color=&#x27;#d97706&#x27;&gt;PDP&lt;/font&gt; = Logical Policy Decision Point&lt;br&gt;&lt;b&gt;Zero Trust pillars:&lt;/b&gt; Identity = Keycloak • Device = Client Certificate + telemetry • Network = segmentation / Pomerium ingress • Application = OpenEMR + policy • Data = MariaDB + audit" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#ffffff;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="830" width="1320" height="105" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="note1" value="&lt;b&gt;Source-grounded note:&lt;/b&gt; Current project documents explicitly define Pomerium as the Zero Trust access gateway/PEP, Keycloak as IdP, Wazuh as monitoring/SIEM, OpenEMR as application, and MariaDB as database." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d1d5db;fillColor=#f9fafb;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="945" width="1320" height="45" as="geometry"/>
