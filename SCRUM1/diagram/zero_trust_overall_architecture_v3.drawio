  <diagram id="zt-architecture" name="Zero Trust Architecture">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2563eb;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;USER / DEVICE&lt;/b&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;Workstation bệnh viện / trình duyệt&lt;br/&gt;Client Certificate + thông tin xác thực người dùng&lt;br/&gt;Trust input: danh tính + trạng thái thiết bị + ngữ cảnh yêu cầu&lt;/p&gt;" vertex="1">
          <mxGeometry height="125" width="350" x="650" y="150" as="geometry" />
        </mxCell>
        <mxCell id="pom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;POMERIUM&lt;/b&gt;&lt;br&gt;Zero Trust Access Proxy&lt;br&gt;&lt;b&gt;PEP&lt;/b&gt; – Policy Enforcement Point&lt;br&gt;Client mTLS / Token &amp;amp; Policy Enforcement&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoint:&lt;/b&gt; HTTPS 443" vertex="1">
          <mxGeometry height="150" width="300" x="1155" y="639.94" as="geometry" />
        </mxCell>
        <mxCell id="pillars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=center;verticalAlign=top;spacing=8;" value="&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;CISA ZERO TRUST MATURITY MODEL (ZTMM) – 5 TRỤ CỘT&lt;/strong&gt;&lt;/p&gt;&lt;ol dir=&quot;auto&quot;&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Identity (Danh tính)&lt;/strong&gt; → Keycloak, MFA, RBAC, OIDC&lt;/li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Devices (Thiết bị)&lt;/strong&gt; → Client Certificate / đầu vào tin cậy thiết bị; giám sát Wazuh&lt;/li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Networks (Mạng)&lt;/strong&gt; → VLAN, phân đoạn giữa các zone, Default DENY&lt;/li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Applications &amp;amp; Workloads (Ứng dụng &amp;amp; Workload)&lt;/strong&gt; → Chính sách Pomerium + phân quyền OpenEMR&lt;/li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Data (Dữ liệu)&lt;/strong&gt; → MariaDB, mã hóa khi lưu trữ/truyền tải, least privilege&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="200" width="450" x="1080" y="917.5" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Framework roles&lt;/b&gt;&lt;/div&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;NIST SP 800-207&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;: kiến trúc / nguyên tắc Zero Trust / mối quan hệ PEP–PDP.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;CISA ZTMM&lt;/b&gt;: năm trụ cột được thể hiện trên sơ đồ này.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="85" width="440" x="50" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#16a34a;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="pom" value="&lt;b&gt;1&lt;/b&gt; Access Request&lt;br&gt;HTTPS 443 + mTLS">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1295.05" y="222.48" />
              <mxPoint x="1295.05" y="580" />
              <mxPoint x="1305" y="580" />
