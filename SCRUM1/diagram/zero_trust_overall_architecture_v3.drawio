        </mxCell>
        <mxCell id="deny" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;" value="&lt;div&gt;&lt;div&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;THỰC THI ZERO TRUST&lt;/strong&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;Default DENY giữa các zone mạng.&lt;/li&gt;&lt;li&gt;Client không bao giờ truy cập trực tiếp OpenEMR / MariaDB.&lt;/li&gt;&lt;li&gt;Chỉ các luồng được ủy quyền rõ ràng mới được phép.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;section&gt;&lt;/section&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
