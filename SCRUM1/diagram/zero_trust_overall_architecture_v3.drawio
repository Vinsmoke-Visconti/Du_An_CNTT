        <mxCell id="t2" parent="1" vertex="1" value="BẢNG THÔNG SỐ / LUỒNG / POLICY CHO SƠ ĐỒ KIẾN TRÚC ZERO TRUST" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;">
          <mxGeometry x="30" y="20" width="1320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="net" parent="1" vertex="1" value="&lt;b&gt;PoC NETWORK MAPPING (ĐỀ XUẤT – IP/VLAN KHÔNG ĐƯỢC CHỐT TRONG 3 TÀI LIỆU GỐC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;VLAN 10 – Client:&lt;/b&gt; 10.20.10.0/24, DHCP 10.20.10.100–200&lt;br&gt;&lt;b&gt;VLAN 20 – DMZ:&lt;/b&gt; 10.20.20.0/24, Pomerium 10.20.20.10 (static)&lt;br&gt;&lt;b&gt;VLAN 30 – Security:&lt;/b&gt; 10.20.30.0/24, Keycloak 10.20.30.10, Wazuh 10.20.30.20 (static)&lt;br&gt;&lt;b&gt;VLAN 40 – App:&lt;/b&gt; 10.20.40.0/24, OpenEMR 10.20.40.10 (static)&lt;br&gt;&lt;b&gt;VLAN 50 – DB:&lt;/b&gt; 10.20.50.0/24, MariaDB 10.20.50.10 (static)&lt;br&gt;&lt;b&gt;VLAN 60 – Management:&lt;/b&gt; 10.20.60.0/24, Proxmox 10.20.60.10 (static)&lt;br&gt;&lt;br&gt;&lt;i&gt;Gateway mẫu cho mỗi VLAN: 10.20.X.1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="30" y="80" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ports" parent="1" vertex="1" value="&lt;b&gt;ENDPOINT / PORTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pomerium&lt;/b&gt;: TCP 443 – external access&lt;br&gt;&lt;b&gt;Keycloak&lt;/b&gt;: TCP 8443 – HTTPS/OIDC (PoC proposed)&lt;br&gt;&lt;b&gt;OpenEMR&lt;/b&gt;: TCP 443 (or 80/8080 only if the deployed PoC uses them internally)&lt;br&gt;&lt;b&gt;MariaDB&lt;/b&gt;: TCP 3306 – OpenEMR only&lt;br&gt;&lt;b&gt;Wazuh&lt;/b&gt;: TCP 1514 – agent communication; TCP 1515 – enrollment; TCP 55000 – API if used&lt;br&gt;&lt;br&gt;&lt;b&gt;mTLS location:&lt;/b&gt; Client/Device → Pomerium only.&lt;br&gt;&lt;b&gt;OIDC location:&lt;/b&gt; Pomerium ↔ Keycloak for authentication redirect/token exchange." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="680" y="80" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="seq" parent="1" vertex="1" value="&lt;b&gt;DETAILED ZERO TRUST REQUEST SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; User/Device sends HTTPS request to Pomerium.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Pomerium validates Client Certificate / mTLS.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Pomerium redirects browser to Keycloak using OIDC/HTTPS.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; User authenticates with account/password + OTP (MFA).&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Keycloak returns authenticated identity / role claims to Pomerium.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Pomerium policy engine (logical PDP) evaluates identity, role, device/context and target resource.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; PDP returns ALLOW or DENY; Pomerium enforces the result as PEP.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Authorized request is proxied to OpenEMR.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; OpenEMR applies application-level authorization and accesses only required records.&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; OpenEMR queries MariaDB over TCP 3306.&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; Pomerium, Keycloak, OpenEMR, MariaDB/hosts and device agents send security/audit events to Wazuh.&lt;br&gt;&lt;b&gt;12.&lt;/b&gt; Wazuh correlates/alerts for monitoring and forensics.&lt;br&gt;&lt;b&gt;13.&lt;/b&gt; Optional future extension: Wazuh Active Response → isolate/block device or integrate with session revocation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="410" width="620" height="370" as="geometry" />
        </mxCell>
        <mxCell id="pol" parent="1" vertex="1" value="&lt;b&gt;MINIMUM INTER-ZONE POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client → Pomerium: &lt;b&gt;ALLOW TCP 443&lt;/b&gt;&lt;br&gt;Client → OpenEMR: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;Client → MariaDB: &lt;b&gt;DENY TCP 3306&lt;/b&gt;&lt;br&gt;Client → Keycloak/Wazuh: &lt;b&gt;DENY&lt;/b&gt; (except explicitly required admin flows)&lt;br&gt;Pomerium → Keycloak: &lt;b&gt;ALLOW OIDC/HTTPS&lt;/b&gt;&lt;br&gt;Pomerium → OpenEMR: &lt;b&gt;ALLOW HTTPS&lt;/b&gt;&lt;br&gt;OpenEMR → MariaDB: &lt;b&gt;ALLOW TCP 3306&lt;/b&gt;&lt;br&gt;All other DB sources → MariaDB: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;Security/Monitoring → workloads: &lt;b&gt;only explicitly required management/agent traffic&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Firewall note:&lt;/b&gt; Inter-VLAN traffic is controlled by &lt;b&gt;Proxmox Firewall / Inter-zone Firewall – Default DENY&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="680" y="410" width="620" height="370" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" vertex="1" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#16a34a&quot;&gt;&lt;b&gt;Green&lt;/b&gt;&lt;/span&gt; = identity/authentication flow&lt;br&gt;&lt;span style=&quot;color:#7c3aed&quot;&gt;&lt;b&gt;Purple&lt;/b&gt;&lt;/span&gt; = control/policy flow&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/span&gt; = data/application flow&lt;br&gt;&lt;span style=&quot;color:#ca8a04&quot;&gt;&lt;b&gt;Gold dashed&lt;/b&gt;&lt;/span&gt; = telemetry/logging&lt;br&gt;&lt;b&gt;PEP&lt;/b&gt; = Policy Enforcement Point&lt;br&gt;&lt;b&gt;PDP&lt;/b&gt; = Policy Decision Point (logical policy engine)&lt;br&gt;&lt;b&gt;IdP&lt;/b&gt; = Identity Provider&lt;br&gt;&lt;b&gt;mTLS&lt;/b&gt; = Client/device certificate authentication to Pomerium&lt;br&gt;&lt;b&gt;OIDC&lt;/b&gt; = Authentication redirect / token-based identity flow with Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="30" y="800" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="refs" parent="1" vertex="1" value="&lt;b&gt;DOCUMENT BASIS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Business/architecture documents establish: Pomerium as Zero Trust access gateway; Keycloak for identity/MFA/RBAC; Wazuh for security monitoring; OpenEMR + MariaDB separated; Proxmox for segmented Private Cloud.&lt;br&gt;&lt;br&gt;&lt;b&gt;Source-derived:&lt;/b&gt; the roles and business flow above.&lt;br&gt;&lt;b&gt;Proposed for PoC:&lt;/b&gt; the 10.20.x.x addressing plan, VLAN IDs, and Keycloak/OpenEMR endpoint ports where not specified in the supplied documents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="680" y="800" width="620" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
