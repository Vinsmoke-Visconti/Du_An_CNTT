  <mxCell id="itadmin1" value="&lt;b&gt;IT ADMIN / MANAGEMENT ENDPOINT&lt;/b&gt;&lt;br&gt;Administrative / Management Access&lt;br&gt;&lt;br&gt;&lt;b&gt;No Pomerium application flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1025" y="90" width="365" height="105" as="geometry"/></mxCell><mxCell id="proxmgmt1" value="&lt;b&gt;PROXMOX VE / ADMIN&lt;/b&gt;&lt;br&gt;Infrastructure Management&lt;br&gt;&lt;br&gt;&lt;b&gt;Management Plane&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="350" height="105" as="geometry"/></mxCell><mxCell id="mgmtlabel1" value="&lt;b&gt;ADMINISTRATIVE / MANAGEMENT FLOWS&lt;/b&gt;&lt;br&gt;Separate from business-user Pomerium flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1015" y="395" width="415" height="60" as="geometry"/></mxCell><mxCell id="polnote1" value="&lt;b&gt;Management policy&lt;/b&gt;&lt;br&gt;IT Admin → Keycloak: ALLOW – Admin / Identity Management&lt;br&gt;IT Admin → Wazuh: ALLOW – Security Monitoring / Dashboard&lt;br&gt;IT Admin → Proxmox: ALLOW – Infrastructure Management&lt;br&gt;IT Admin → OpenEMR via Pomerium: not used in current PoC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1015" y="480" width="415" height="125" as="geometry"/></mxCell><mxCell id="eadm1" value="Admin / Identity Management" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="itadmin1" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eadm2" value="Security Monitoring / Dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="itadmin1" target="wazuh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eadm3" value="Infrastructure Management" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="itadmin1" target="proxmgmt1"><mxGeometry relative="1" as="geometry"/></mxCell></diagram>
