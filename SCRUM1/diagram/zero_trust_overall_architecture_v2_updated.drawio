          <mxGeometry x="30" y="20" width="1320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="net" parent="1" vertex="1" value="&lt;b&gt;PoC NETWORK MAPPING (ĐỀ XUẤT – IP/VLAN KHÔNG ĐƯỢC CHỐT TRONG 3 TÀI LIỆU GỐC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;VLAN 10 – Client:&lt;/b&gt; 10.10.10.0/24 | GW 10.10.10.1 | DHCP 10.10.10.100–200&lt;br&gt;&lt;b&gt;VLAN 20 – DMZ:&lt;/b&gt; 10.10.20.0/24 | GW 10.10.20.1 | Pomerium Gateway 10.10.20.10&lt;br&gt;&lt;b&gt;VLAN 30 – Security:&lt;/b&gt; 10.10.30.0/24 | GW 10.10.30.1 | Keycloak 10.10.30.10 | Wazuh Manager 10.10.30.20&lt;br&gt;&lt;b&gt;VLAN 40 – Internal App:&lt;/b&gt; 10.10.40.0/24 | GW 10.10.40.1 | OpenEMR Web Server 10.10.40.10&lt;br&gt;&lt;b&gt;VLAN 50 – DB:&lt;/b&gt; 10.10.50.0/24 | GW 10.10.50.1 | MariaDB 10.10.50.10&lt;br&gt;&lt;b&gt;VLAN 60 – Proxmox Management:&lt;/b&gt; 10.10.60.0/24 | GW 10.10.60.1 | Proxmox VE / Admin 10.10.60.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="30" y="80" width="620" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="ports" parent="1" vertex="1" value="&lt;b&gt;ENDPOINT / PORTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pomerium Gateway&lt;/b&gt;: TCP 443 – HTTPS / client mTLS&lt;br&gt;&lt;b&gt;Keycloak&lt;/b&gt;: TCP 8443 – HTTPS/OIDC/MFA (PoC proposed)&lt;br&gt;&lt;b&gt;OpenEMR Web Server&lt;/b&gt;: HTTPS 443 / HTTP 80*&lt;br&gt;&lt;b&gt;MariaDB&lt;/b&gt;: TCP 3306 – OpenEMR only&lt;br&gt;&lt;b&gt;Wazuh Manager&lt;/b&gt;: 1514/TCP agent communication; 1515/TCP enrollment; 55000/TCP API*&lt;br&gt;&lt;b&gt;Proxmox VE / Admin&lt;/b&gt;: management access by policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="680" y="80" width="620" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="seq" parent="1" vertex="1" value="&lt;b&gt;DETAILED ZERO TRUST REQUEST SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; User/Device sends HTTPS request to Pomerium with Client Certificate/mTLS.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Pomerium starts OIDC authentication redirect to Keycloak.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Browser reaches Keycloak over HTTPS 8443 for account/password + OTP (MFA).&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Keycloak returns OIDC token/claims to Pomerium.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Pomerium/Logical PDP evaluates identity, role, resource and request context.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; PDP returns ALLOW/DENY; Pomerium enforces the decision.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Authorized request reaches OpenEMR over HTTPS.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; OpenEMR queries MariaDB over TCP 3306.&lt;br&gt;&lt;b&gt;9–13.&lt;/b&gt; Application, IAM, proxy, DB/host and device security telemetry is sent to Wazuh for monitoring/alerting.&lt;br&gt;&lt;br&gt;&lt;b&gt;Management flow:&lt;/b&gt; IT Admin accesses Proxmox, Keycloak and Wazuh directly by management policy; no IT Admin → Pomerium → OpenEMR flow is used in this PoC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="30" y="410" width="620" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="pol" parent="1" vertex="1" value="&lt;b&gt;MINIMUM INTER-ZONE / MANAGEMENT POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client → Pomerium: &lt;b&gt;ALLOW TCP 443&lt;/b&gt;&lt;br&gt;Client/Browser → Keycloak: &lt;b&gt;ALLOW TCP 8443 – OIDC/MFA only&lt;/b&gt;&lt;br&gt;Normal User/Browser → Wazuh Dashboard: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;IT Admin → Keycloak: &lt;b&gt;ALLOW – Admin / Identity Management&lt;/b&gt;&lt;br&gt;IT Admin → Wazuh: &lt;b&gt;ALLOW – Security Monitoring / Dashboard&lt;/b&gt;&lt;br&gt;IT Admin → Proxmox: &lt;b&gt;ALLOW – Infrastructure Management&lt;/b&gt;&lt;br&gt;Client → OpenEMR: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;IT Admin → OpenEMR via Pomerium: &lt;b&gt;Not used in current PoC&lt;/b&gt;&lt;br&gt;Pomerium → Keycloak: &lt;b&gt;ALLOW – OIDC&lt;/b&gt;&lt;br&gt;Pomerium → OpenEMR: &lt;b&gt;ALLOW&lt;/b&gt;&lt;br&gt;OpenEMR → MariaDB: &lt;b&gt;ALLOW TCP 3306&lt;/b&gt;&lt;br&gt;Other sources → MariaDB: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;Agents/Hosts → Wazuh: &lt;b&gt;ALLOW required telemetry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="680" y="410" width="620" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="leg" parent="1" vertex="1" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#f97316&quot;&gt;&lt;b&gt;Orange solid&lt;/b&gt;&lt;/span&gt; = User / Client Access Flow&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;&lt;b&gt;Blue solid&lt;/b&gt;&lt;/span&gt; = Control / Authentication / Policy / Management Flow&lt;br&gt;&lt;span style=&quot;color:#16a34a&quot;&gt;&lt;b&gt;Green solid&lt;/b&gt;&lt;/span&gt; = Data Flow&lt;br&gt;&lt;span style=&quot;color:#7c3aed&quot;&gt;&lt;b&gt;Purple dashed&lt;/b&gt;&lt;/span&gt; = Logs / Security Telemetry&lt;br&gt;&lt;span style=&quot;color:#dc2626&quot;&gt;&lt;b&gt;Red dashed&lt;/b&gt;&lt;/span&gt; = DENY / Blocked Flow&lt;br&gt;&lt;br&gt;&lt;b&gt;Note:&lt;/b&gt; Device posture integration from Wazuh to Pomerium/PDP and automatic session revocation are not implemented in the current PoC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="30" y="800" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="refs" parent="1" vertex="1" value="&lt;b&gt;DOCUMENT BASIS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Business/architecture documents establish: Pomerium as Zero Trust access gateway; Keycloak as IdP/MFA/RBAC; Wazuh as monitoring/logging; OpenEMR as application; MariaDB as EMR data store; Proxmox as private-cloud infrastructure.&lt;br&gt;&lt;br&gt;&lt;b&gt;Current PoC clarification:&lt;/b&gt; Client Certificate / Device Identity is enforced at Pomerium; Wazuh provides monitoring/alerting, not device-posture decisions for Pomerium." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;">
          <mxGeometry x="680" y="800" width="620" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>