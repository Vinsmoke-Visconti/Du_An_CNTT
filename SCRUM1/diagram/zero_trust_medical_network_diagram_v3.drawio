        <mxCell id="7DGryhYYoJN_tTkDn_Sx-88" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;align=left;verticalAlign=middle;" value="&lt;div&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;CHÚ GIẢI (LEGEND)&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🖥 Biểu tượng Device/VM = endpoint hoặc server&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🔀 Switch = Proxmox vSwitch / cầu nối hỗ trợ VLAN&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🧱 Firewall = Proxmox Firewall / phân đoạn giữa các zone&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🔵 Nét liền xanh dương = ALLOW / Authentication / Application Access&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🟢 Nét liền xanh lá = Data Flow / Database&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🟣 Nét đứt tím = Logs / Security Telemetry&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🔴 Nét đứt đỏ = DENY / Blocked Traffic&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;🟠 Nét liền cam = External / Network Infrastructure&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;* = phụ thuộc cấu hình PoC cuối cùng; không khẳng định trừ khi đã triển khai.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="174.49" width="580" x="2050.02" y="-1095.52" as="geometry" />
        </mxCell>
        <mxCell id="7DGryhYYoJN_tTkDn_Sx-89" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#4b5563;" value="PoC addressing proposal. IPs/VLANs are design values, not implementation facts from the source documents. Client addressing is DHCP; static IPs are reserved for infrastructure/VMs. VLAN 60 separates Proxmox management from application/data traffic." vertex="1">
