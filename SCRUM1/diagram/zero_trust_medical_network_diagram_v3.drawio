        <mxCell id="7DGryhYYoJN_tTkDn_Sx-77" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2937;" value="BẢO MẬT HỒ SƠ Y TẾ BẰNG KIẾN TRÚC ZERO TRUST TRÊN NỀN TẢNG CLOUD Sơ đồ mạng PoC – VLAN / Subnet / IP / Port / Firewall Policy" vertex="1">
