        <mxCell id="deny" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;" value="&lt;div&gt;&lt;b&gt;Access-control principle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;Người dùng nghiệp vụ truy cập OpenEMR thông qua Pomerium.&lt;br/&gt;IT Admin sử dụng đường truy cập quản trị riêng đến Proxmox, Keycloak và Wazuh.&lt;br/&gt;Không có luồng IT Admin -&amp;gt; Pomerium →&amp;gt;OpenEMR trong PoC hiện tại.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="440" x="580" y="1090" as="geometry" />
