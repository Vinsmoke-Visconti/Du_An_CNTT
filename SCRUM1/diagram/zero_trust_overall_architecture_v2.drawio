        <mxCell id="ywIlljXEnwP8iZMfXt-f-2" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Các cập nhật chính gồm:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Client Certificate / Device Identity thay cho Device Status.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Client → Pomerium: cam, nét liền – HTTPS 443 + mTLS.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Pomerium → Keycloak: xanh dương, nét liền – OIDC / HTTPS Authentication Redirect.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;User/Browser → Keycloak: MFA/Identity flow.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;OpenEMR → MariaDB: xanh lá, nét liền – TCP 3306.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Logs/Security Telemetry → Wazuh: tím, nét đứt.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Không còn mô tả Wazuh là nguồn device posture quyết định Pomerium/PDP.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Thêm IT Admin / Management Endpoint với các luồng quản trị riêng tới:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Keycloak&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Wazuh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Proxmox VE / Admin&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Ghi rõ không có IT Admin → Pomerium → OpenEMR trong PoC.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Đồng bộ IP sang 10.10.x.x theo bảng Excel.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Cập nhật VLAN 10–60, port và policy.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Cập nhật Legend cho 5 loại luồng.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="290" x="1120" y="1040" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Parameters &amp; Policies" id="1IQTVerfymL7O-UfMEI0">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="BẢNG THÔNG SỐ / LUỒNG / POLICY CHO SƠ ĐỒ KIẾN TRÚC ZERO TRUST" vertex="1">
          <mxGeometry height="40" width="1270" x="165" y="20" as="geometry" />
        </mxCell>
        <mxCell id="net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;PoC NETWORK MAPPING (ĐỀ XUẤT – IP/VLAN KHÔNG ĐƯỢC CHỐT TRONG 3 TÀI LIỆU GỐC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 10 – Client:&lt;/b&gt; 10.10.10.0/24 | GW 10.10.10.1 | DHCP 10.10.10.100–200&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 20 – DMZ:&lt;/b&gt; 10.10.20.0/24 | GW 10.10.20.1 | Pomerium Gateway 10.10.20.10&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 30 – Security:&lt;/b&gt; 10.10.30.0/24 | GW 10.10.30.1 | Keycloak 10.10.30.10 | Wazuh Manager 10.10.30.20&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 40 – Internal App:&lt;/b&gt; 10.10.40.0/24 | GW 10.10.40.1 | OpenEMR Web Server 10.10.40.10&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 50 – DB:&lt;/b&gt; 10.10.50.0/24 | GW 10.10.50.1 | MariaDB 10.10.50.10&lt;br&gt;&lt;b style=&quot;&quot;&gt;VLAN 60 – Proxmox Management:&lt;/b&gt; 10.10.60.0/24 | GW 10.10.60.1 | Proxmox VE / Admin 10.10.60.10&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="165" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ports" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;ENDPOINT / PORTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Pomerium Gateway&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;: TCP 443 – HTTPS / client mTLS&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Keycloak&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;: TCP 8443 – HTTPS/OIDC/MFA (PoC proposed)&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;OpenEMR Web Server&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;: HTTPS 443 / HTTP 80*&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;MariaDB&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;: TCP 3306 – OpenEMR only&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Wazuh Manager&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;: 1514/TCP&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px; white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;giao tiếp agent&lt;/span&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;; 1515/TCP enrollment; 55000/TCP API*&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Proxmox VE / Admin&lt;/b&gt;:&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;truy cập quản trị theo chính sách&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="815" y="80" as="geometry" />
        </mxCell>
        <mxCell id="seq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" value="&lt;div style=&quot;&quot;&gt;&lt;h3 dir=&quot;auto&quot; style=&quot;&quot;&gt;DETAILED ZERO TRUST REQUEST SEQUENCE&lt;/h3&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;(Trình tự yêu cầu Zero Trust chi tiết)&lt;/strong&gt;&lt;/p&gt;&lt;ol dir=&quot;auto&quot;&gt;&lt;li style=&quot;text-align: left;&quot;&gt;User/Device gửi yêu cầu HTTPS đến Pomerium kèm Client Certificate/mTLS.&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Pomerium bắt đầu chuyển hướng xác thực OIDC đến Keycloak.&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Trình duyệt truy cập Keycloak qua HTTPS 8443 để xác thực tài khoản/mật khẩu + OTP (MFA).&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Keycloak trả về token/claims OIDC cho Pomerium.&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Pomerium/Logical PDP đánh giá danh tính, vai trò, tài nguyên và ngữ cảnh yêu cầu.&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;PDP trả về ALLOW/DENY; Pomerium thực thi quyết định.&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Yêu cầu được ủy quyền đến OpenEMR qua HTTPS.&lt;/li&gt;&lt;li&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;OpenEMR truy vấn MariaDB qua TCP 3306.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;9–13. Telemetry bảo mật từ ứng dụng, IAM, proxy, DB/host và thiết bị được gửi đến Wazuh để giám sát/cảnh báo.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: left; white-space: pre-wrap;&quot;&gt;&lt;strong&gt;Luồng quản trị:&lt;/strong&gt; IT Admin truy cập trực tiếp Proxmox, Keycloak và Wazuh theo chính sách quản trị; &lt;strong&gt;không sử dụng&lt;/strong&gt; luồng IT Admin → Pomerium → OpenEMR trong PoC này.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="620" x="165" y="240" as="geometry" />
        </mxCell>
        <mxCell id="pol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" value="&lt;h3 dir=&quot;auto&quot; style=&quot;&quot;&gt;MINIMUM INTER-ZONE / MANAGEMENT POLICY&lt;/h3&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong&gt;(Chính sách tối thiểu giữa các zone / quản trị)&lt;/strong&gt;&lt;/p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Client → Pomerium: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW TCP 443&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Client/Browser → Keycloak: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW TCP 8443 – chỉ OIDC/MFA&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Normal User/Browser → Wazuh Dashboard: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DENY&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IT Admin → Keycloak: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW – Quản trị Admin / Danh tính&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IT Admin → Wazuh: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW – Giám sát bảo mật / Dashboard&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IT Admin → Proxmox: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW – Quản trị hạ tầng&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Client → OpenEMR: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DENY&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IT Admin → OpenEMR qua Pomerium: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Không sử dụng trong PoC hiện tại&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Pomerium → Keycloak: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW – OIDC&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Pomerium → OpenEMR: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;OpenEMR → MariaDB: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW TCP 3306&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Các nguồn khác → MariaDB: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DENY&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agents/Hosts → Wazuh: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALLOW telemetry bắt buộc&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="350" width="620" x="815" y="240" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(249, 115, 22);&quot;&gt;&lt;b&gt;Orange solid&lt;/b&gt;&lt;/span&gt; =&amp;nbsp;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Luồng truy cập User / Client&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(37, 99, 235);&quot;&gt;&lt;b&gt;Blue solid&lt;/b&gt;&lt;/span&gt; =&amp;nbsp;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Luồng Điều khiển / Xác thực / Chính sách / Quản trị&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(22, 163, 74);&quot;&gt;&lt;b&gt;Green solid&lt;/b&gt;&lt;/span&gt; =&amp;nbsp;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Luồng Dữ liệu&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(124, 58, 237);&quot;&gt;&lt;b&gt;Purple dashed&lt;/b&gt;&lt;/span&gt; =&amp;nbsp;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Logs / Telemetry bảo mật&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(220, 38, 38);&quot;&gt;&lt;b&gt;Red dashed&lt;/b&gt;&lt;/span&gt; =&amp;nbsp;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DENY / Luồng bị chặn&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;p dir=&quot;auto&quot; style=&quot;white-space: pre-wrap;&quot;&gt;&lt;b&gt;Ghi chú:&lt;/b&gt; Tích hợp trạng thái thiết bị từ Wazuh về Pomerium/PDP và thu hồi phiên tự động chưa được triển khai trong PoC hiện tại.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="620" x="165" y="610" as="geometry" />
        </mxCell>
        <mxCell id="refs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="&lt;div&gt;&lt;div&gt;&lt;h3 dir=&quot;auto&quot; style=&quot;text-align: center;&quot;&gt;DOCUMENT BASIS&lt;/h3&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: center; white-space: pre-wrap;&quot;&gt;&lt;strong&gt;(Cơ sở tài liệu)&lt;/strong&gt;&lt;/p&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: justify; white-space: pre-wrap;&quot;&gt;Các tài liệu nghiệp vụ/kiến trúc xác định: Pomerium là cổng truy cập Zero Trust; Keycloak là IdP/MFA/RBAC; Wazuh là giám sát/ghi log; OpenEMR là ứng dụng; MariaDB là kho dữ liệu EMR; Proxmox là hạ tầng private-cloud.&lt;/p&gt;&lt;p dir=&quot;auto&quot; style=&quot;text-align: justify; white-space: pre-wrap;&quot;&gt;&lt;strong&gt;Làm rõ PoC hiện tại:&lt;/strong&gt; Client Certificate / Device Identity được thực thi tại Pomerium; Wazuh cung cấp giám sát/cảnh báo, &lt;strong&gt;không&lt;/strong&gt; đưa quyết định trạng thái thiết bị cho Pomerium.&lt;/p&gt;&lt;/div&gt;&lt;div style=&quot;top: 1865.5px; left: 0px;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;section&gt;&lt;/section&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="620" x="815" y="610" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
