<mxfile host="app.diagrams.net" modified="2026-08-23T00:00:00.000Z" agent="Mozilla/5.0" version="24.7.17" type="device">
  <diagram id="zt-architecture" name="Zero Trust Architecture">
    <mxGraphModel dx="1420" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" vertex="1" value="BẢO MẬT HỒ SƠ Y TẾ BẰNG KIẾN TRÚC ZERO TRUST – SƠ ĐỒ KIẾN TRÚC TỔNG THỂ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;"><mxGeometry x="30" y="20" width="1320" height="40" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" vertex="1" value="NIST SP 800-207 aligned architecture  |  CISA ZTMM 5 Pillars  |  PoC trên Proxmox Private Cloud" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;"><mxGeometry x="30" y="55" width="1320" height="25" as="geometry"/></mxCell><mxCell id="cp" parent="1" vertex="1" value="CONTROL PLANE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fb;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=5 5;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;"><mxGeometry x="430" y="95" width="850" height="300" as="geometry"/></mxCell><mxCell id="dp" parent="1" vertex="1" value="DATA PLANE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fb;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;dashPattern=5 5;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;"><mxGeometry x="430" y="420" width="850" height="315" as="geometry"/></mxCell><mxCell id="user" parent="1" vertex="1" value="&lt;b&gt;USER / DEVICE&lt;/b&gt;&lt;br&gt;Hospital workstation / browser&lt;br&gt;Client Certificate + user credentials&lt;br&gt;&lt;b&gt;Trust inputs:&lt;/b&gt; identity + device posture + request context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2563eb;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="300" width="250" height="125" as="geometry"/></mxCell><mxCell id="pom" parent="1" vertex="1" value="&lt;b&gt;POMERIUM&lt;/b&gt;&lt;br&gt;Zero Trust Access Proxy&lt;br&gt;&lt;b&gt;PEP&lt;/b&gt; – Policy Enforcement Point&lt;br&gt;Client mTLS / Token &amp;amp; Policy Enforcement&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoint:&lt;/b&gt; HTTPS 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="330" y="285" width="300" height="150" as="geometry"/></mxCell><mxCell id="kc" parent="1" vertex="1" value="&lt;b&gt;KEYCLOAK&lt;/b&gt;&lt;br&gt;Identity Provider (IdP)&lt;br&gt;OIDC / MFA / RBAC&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoint:&lt;/b&gt; HTTPS 8443 (PoC proposed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefdf3;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="670" y="125" width="260" height="135" as="geometry"/></mxCell><mxCell id="pdp" parent="1" vertex="1" value="&lt;b&gt;POLICY ENGINE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Logical PDP&lt;/b&gt; – Policy Decision Point&lt;br&gt;Evaluates identity, role, resource and context&lt;br&gt;&lt;br&gt;Decision: &lt;b&gt;ALLOW / DENY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="965" y="125" width="270" height="135" as="geometry"/></mxCell><mxCell id="wazuh" parent="1" vertex="1" value="&lt;b&gt;WAZUH MANAGER&lt;/b&gt;&lt;br&gt;SIEM / Security Monitoring&lt;br&gt;Audit, alerting, correlation, response&lt;br&gt;&lt;br&gt;&lt;b&gt;Ports:&lt;/b&gt; 1514/TCP, 1515/TCP, 55000/TCP*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="670" y="285" width="565" height="85" as="geometry"/></mxCell><mxCell id="emr" parent="1" vertex="1" value="&lt;b&gt;OPENEMR&lt;/b&gt;&lt;br&gt;Medical Records Application&lt;br&gt;Application authorization / least privilege&lt;br&gt;&lt;br&gt;&lt;b&gt;Endpoint:&lt;/b&gt; HTTPS 443 (PoC) / internal service port as deployed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="670" y="465" width="270" height="145" as="geometry"/></mxCell><mxCell id="db" parent="1" vertex="1" value="&lt;b&gt;MARIADB&lt;/b&gt;&lt;br&gt;EMR Data Store&lt;br&gt;Patient / clinical data&lt;br&gt;&lt;br&gt;&lt;b&gt;Port:&lt;/b&gt; TCP 3306&lt;br&gt;&lt;b&gt;Access:&lt;/b&gt; OpenEMR only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#be185d;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="985" y="465" width="250" height="145" as="geometry"/></mxCell><mxCell id="pillars" parent="1" vertex="1" value="&lt;b&gt;CISA ZERO TRUST MATURITY MODEL (ZTMM) – 5 PILLARS&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Identity&lt;/b&gt; → Keycloak, MFA, RBAC, OIDC&lt;br&gt;2. &lt;b&gt;Devices&lt;/b&gt; → Client Certificate / device trust inputs; Wazuh monitoring&lt;br&gt;3. &lt;b&gt;Networks&lt;/b&gt; → VLANs, inter-zone segmentation, Default DENY&lt;br&gt;4. &lt;b&gt;Applications &amp;amp; Workloads&lt;/b&gt; → Pomerium policy + OpenEMR authorization&lt;br&gt;5. &lt;b&gt;Data&lt;/b&gt; → MariaDB, encryption at rest/in transit, least privilege" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="30" y="465" width="360" height="220" as="geometry"/></mxCell><mxCell id="note1" parent="1" vertex="1" value="&lt;b&gt;Framework roles&lt;/b&gt;&lt;br&gt;&lt;b&gt;NIST SP 800-207:&lt;/b&gt; architecture / zero trust principles / PEP-PDP relationship.&lt;br&gt;&lt;b&gt;CISA ZTMM:&lt;/b&gt; the five pillars shown on this diagram." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="30" y="700" width="360" height="95" as="geometry"/></mxCell><mxCell id="note2" parent="1" vertex="1" value="&lt;b&gt;PoC boundary&lt;/b&gt;&lt;br&gt;Automatic session revocation after device trust changes is &lt;b&gt;not specified in the current project documents&lt;/b&gt;. Wazuh is currently the monitoring/alerting plane; automated Active Response can be treated as a future/optional extension." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="670" y="625" width="565" height="110" as="geometry"/></mxCell><mxCell id="e1" parent="1" edge="1" source="user" target="pom" value="&lt;b&gt;1&lt;/b&gt; Access Request&lt;br&gt;HTTPS 443 + mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#16a34a;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" parent="1" edge="1" source="pom" target="kc" value="&lt;b&gt;2&lt;/b&gt; OIDC / HTTPS&lt;br&gt;Authentication Redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#16a34a;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" parent="1" edge="1" source="user" target="kc" value="&lt;b&gt;3&lt;/b&gt; MFA + Identity Authentication&lt;br&gt;Account / Password / OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#16a34a;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" parent="1" edge="1" source="kc" target="pom" value="&lt;b&gt;4&lt;/b&gt; OIDC Token / Claims&lt;br&gt;role / identity context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#7c3aed;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" parent="1" edge="1" source="pom" target="pdp" value="&lt;b&gt;5&lt;/b&gt; Policy Evaluation Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#7c3aed;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" parent="1" edge="1" source="pdp" target="pom" value="&lt;b&gt;6&lt;/b&gt; Policy Decision&lt;br&gt;ALLOW / DENY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#7c3aed;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" parent="1" edge="1" source="pom" target="emr" value="&lt;b&gt;7&lt;/b&gt; Authorized Request&lt;br&gt;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#2563eb;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" parent="1" edge="1" source="emr" target="db" value="&lt;b&gt;8&lt;/b&gt; Clinical Data Query&lt;br&gt;TCP 3306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#2563eb;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" parent="1" edge="1" source="emr" target="wazuh" value="&lt;b&gt;9&lt;/b&gt; Audit / Security Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#ca8a04;dashed=1;dashPattern=6 4;endArrow=open;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" parent="1" edge="1" source="kc" target="wazuh" value="&lt;b&gt;10&lt;/b&gt; Authentication / IAM Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#ca8a04;dashed=1;dashPattern=6 4;endArrow=open;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" parent="1" edge="1" source="pom" target="wazuh" value="&lt;b&gt;11&lt;/b&gt; Access / Policy / Proxy Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#ca8a04;dashed=1;dashPattern=6 4;endArrow=open;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" parent="1" edge="1" source="db" target="wazuh" value="&lt;b&gt;12&lt;/b&gt; DB / Host Security Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#ca8a04;dashed=1;dashPattern=6 4;endArrow=open;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" parent="1" edge="1" source="user" target="wazuh" value="&lt;b&gt;13&lt;/b&gt; Device Security Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=block;strokeColor=#ca8a04;dashed=1;dashPattern=6 4;endArrow=open;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deny" parent="1" vertex="1" value="&lt;b&gt;ZERO TRUST ENFORCEMENT&lt;/b&gt;&lt;br&gt;Default DENY between network zones.&lt;br&gt;Client never reaches OpenEMR / MariaDB directly.&lt;br&gt;Only explicitly authorized flows are allowed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="330" y="625" width="300" height="110" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram id="zt-parameters" name="Parameters &amp; Policies">
    <mxGraphModel dx="1420" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" parent="1" vertex="1" value="BẢNG THÔNG SỐ / LUỒNG / POLICY CHO SƠ ĐỒ KIẾN TRÚC ZERO TRUST" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;"><mxGeometry x="30" y="20" width="1320" height="40" as="geometry"/></mxCell><mxCell id="net" parent="1" vertex="1" value="&lt;b&gt;PoC NETWORK MAPPING (ĐỀ XUẤT – IP/VLAN KHÔNG ĐƯỢC CHỐT TRONG 3 TÀI LIỆU GỐC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;VLAN 10 – Client:&lt;/b&gt; 10.20.10.0/24, DHCP 10.20.10.100–200&lt;br&gt;&lt;b&gt;VLAN 20 – DMZ:&lt;/b&gt; 10.20.20.0/24, Pomerium 10.20.20.10 (static)&lt;br&gt;&lt;b&gt;VLAN 30 – Security:&lt;/b&gt; 10.20.30.0/24, Keycloak 10.20.30.10, Wazuh 10.20.30.20 (static)&lt;br&gt;&lt;b&gt;VLAN 40 – App:&lt;/b&gt; 10.20.40.0/24, OpenEMR 10.20.40.10 (static)&lt;br&gt;&lt;b&gt;VLAN 50 – DB:&lt;/b&gt; 10.20.50.0/24, MariaDB 10.20.50.10 (static)&lt;br&gt;&lt;b&gt;VLAN 60 – Management:&lt;/b&gt; 10.20.60.0/24, Proxmox 10.20.60.10 (static)&lt;br&gt;&lt;br&gt;&lt;i&gt;Gateway mẫu cho mỗi VLAN: 10.20.X.1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="30" y="80" width="620" height="300" as="geometry"/></mxCell><mxCell id="ports" parent="1" vertex="1" value="&lt;b&gt;ENDPOINT / PORTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pomerium&lt;/b&gt;: TCP 443 – external access&lt;br&gt;&lt;b&gt;Keycloak&lt;/b&gt;: TCP 8443 – HTTPS/OIDC (PoC proposed)&lt;br&gt;&lt;b&gt;OpenEMR&lt;/b&gt;: TCP 443 (or 80/8080 only if the deployed PoC uses them internally)&lt;br&gt;&lt;b&gt;MariaDB&lt;/b&gt;: TCP 3306 – OpenEMR only&lt;br&gt;&lt;b&gt;Wazuh&lt;/b&gt;: TCP 1514 – agent communication; TCP 1515 – enrollment; TCP 55000 – API if used&lt;br&gt;&lt;br&gt;&lt;b&gt;mTLS location:&lt;/b&gt; Client/Device → Pomerium only.&lt;br&gt;&lt;b&gt;OIDC location:&lt;/b&gt; Pomerium ↔ Keycloak for authentication redirect/token exchange." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="680" y="80" width="620" height="300" as="geometry"/></mxCell><mxCell id="seq" parent="1" vertex="1" value="&lt;b&gt;DETAILED ZERO TRUST REQUEST SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; User/Device sends HTTPS request to Pomerium.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Pomerium validates Client Certificate / mTLS.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Pomerium redirects browser to Keycloak using OIDC/HTTPS.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; User authenticates with account/password + OTP (MFA).&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Keycloak returns authenticated identity / role claims to Pomerium.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Pomerium policy engine (logical PDP) evaluates identity, role, device/context and target resource.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; PDP returns ALLOW or DENY; Pomerium enforces the result as PEP.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Authorized request is proxied to OpenEMR.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; OpenEMR applies application-level authorization and accesses only required records.&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; OpenEMR queries MariaDB over TCP 3306.&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; Pomerium, Keycloak, OpenEMR, MariaDB/hosts and device agents send security/audit events to Wazuh.&lt;br&gt;&lt;b&gt;12.&lt;/b&gt; Wazuh correlates/alerts for monitoring and forensics.&lt;br&gt;&lt;b&gt;13.&lt;/b&gt; Optional future extension: Wazuh Active Response → isolate/block device or integrate with session revocation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="30" y="410" width="620" height="370" as="geometry"/></mxCell><mxCell id="pol" parent="1" vertex="1" value="&lt;b&gt;MINIMUM INTER-ZONE POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client → Pomerium: &lt;b&gt;ALLOW TCP 443&lt;/b&gt;&lt;br&gt;Client → OpenEMR: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;Client → MariaDB: &lt;b&gt;DENY TCP 3306&lt;/b&gt;&lt;br&gt;Client → Keycloak/Wazuh: &lt;b&gt;DENY&lt;/b&gt; (except explicitly required admin flows)&lt;br&gt;Pomerium → Keycloak: &lt;b&gt;ALLOW OIDC/HTTPS&lt;/b&gt;&lt;br&gt;Pomerium → OpenEMR: &lt;b&gt;ALLOW HTTPS&lt;/b&gt;&lt;br&gt;OpenEMR → MariaDB: &lt;b&gt;ALLOW TCP 3306&lt;/b&gt;&lt;br&gt;All other DB sources → MariaDB: &lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;Security/Monitoring → workloads: &lt;b&gt;only explicitly required management/agent traffic&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Firewall note:&lt;/b&gt; Inter-VLAN traffic is controlled by &lt;b&gt;Proxmox Firewall / Inter-zone Firewall – Default DENY&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;"><mxGeometry x="680" y="410" width="620" height="370" as="geometry"/></mxCell><mxCell id="leg" parent="1" vertex="1" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#16a34a&quot;&gt;&lt;b&gt;Green&lt;/b&gt;&lt;/span&gt; = identity/authentication flow&lt;br&gt;&lt;span style=&quot;color:#7c3aed&quot;&gt;&lt;b&gt;Purple&lt;/b&gt;&lt;/span&gt; = control/policy flow&lt;br&gt;&lt;span style=&quot;color:#2563eb&quot;&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/span&gt; = data/application flow&lt;br&gt;&lt;span style=&quot;color:#ca8a04&quot;&gt;&lt;b&gt;Gold dashed&lt;/b&gt;&lt;/span&gt; = telemetry/logging&lt;br&gt;&lt;b&gt;PEP&lt;/b&gt; = Policy Enforcement Point&lt;br&gt;&lt;b&gt;PDP&lt;/b&gt; = Policy Decision Point (logical policy engine)&lt;br&gt;&lt;b&gt;IdP&lt;/b&gt; = Identity Provider&lt;br&gt;&lt;b&gt;mTLS&lt;/b&gt; = Client/device certificate authentication to Pomerium&lt;br&gt;&lt;b&gt;OIDC&lt;/b&gt; = Authentication redirect / token-based identity flow with Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="30" y="800" width="620" height="200" as="geometry"/></mxCell><mxCell id="refs" parent="1" vertex="1" value="&lt;b&gt;DOCUMENT BASIS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Business/architecture documents establish: Pomerium as Zero Trust access gateway; Keycloak for identity/MFA/RBAC; Wazuh for security monitoring; OpenEMR + MariaDB separated; Proxmox for segmented Private Cloud.&lt;br&gt;&lt;br&gt;&lt;b&gt;Source-derived:&lt;/b&gt; the roles and business flow above.&lt;br&gt;&lt;b&gt;Proposed for PoC:&lt;/b&gt; the 10.20.x.x addressing plan, VLAN IDs, and Keycloak/OpenEMR endpoint ports where not specified in the supplied documents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="680" y="800" width="620" height="200" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>